[settings]
os=Windows
arch=x86
compiler=clang
compiler.version=21
compiler.runtime=dynamic
compiler.cppstd=23

[buildenv]

CFLAGS=-DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
CXXFLAGS=-DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
CL=/DWINVER=0x0A00 /D_WIN32_WINNT=0x0A00

[conf]
*:tools.cmake.cmaketoolchain:generator=Ninja
*:tools.cmake.cmaketoolchain:user_toolchain+={{profile_dir}}/linux.cmake