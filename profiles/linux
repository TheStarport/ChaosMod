[settings]
os=Windows
arch=x86
compiler=msvc
compiler.version=195
compiler.runtime=dynamic
compiler.cppstd=23

[buildenv]
CC={{ os.path.join(os.getenv("MSVC"), "bin", "x86", "cl") }}
CXX={{ os.path.join(os.getenv("MSVC"), "bin", "x86", "cl") }}
LD={{ os.path.join(os.getenv("MSVC"), "bin", "x86", "link") }}
RC={{ os.path.join(os.getenv("MSVC"), "bin", "x86", "rc") }}

CFLAGS=-DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
CXXFLAGS=-DWINVER=0x0A00 -D_WIN32_WINNT=0x0A00
CL=/DWINVER=0x0A00 /D_WIN32_WINNT=0x0A00

[conf]
*:tools.cmake.cmaketoolchain:generator=Ninja
*:tools.cmake.cmaketoolchain:user_toolchain+={{profile_dir}}/linux.cmake